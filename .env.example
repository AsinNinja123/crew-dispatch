# Copy these into Vercel → Project → Settings → Environment Variables.
# NEVER commit real values. This file is just a template.

# Airtable Personal Access Token (create at https://airtable.com/create/tokens)
# Scopes needed: data.records:read, data.records:write, schema.bases:read
AIRTABLE_TOKEN=patXXXXXXXXXXXXXX

# The base to read/write. Practice base is appROy3jYQFr2qASd.
# Swap to your dad's real base id when you go live.
AIRTABLE_BASE_ID=appROy3jYQFr2qASd

# OPTIONAL board password. If set, dad's board + all write endpoints require it.
# Leave unset for v1 if you want zero friction (board is then open to anyone
# who has the URL). Recommended: set something.
ADMIN_KEY=

# Business timezone — decides what "today" means for the permanent worker links.
# Set this to your dad's actual zone or the worker links may flip to the wrong
# day around midnight. Defaults to America/New_York if unset.
# Examples: America/New_York, America/Chicago, America/Denver, America/Los_Angeles
TIMEZONE=America/New_York
